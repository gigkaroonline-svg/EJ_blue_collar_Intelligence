{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env --env-file=.env.dev src/server.ts",
    "build": "tsc",
    "start": "tsx --env-file=.env --env-file=.env.dev src/server.ts",
    "start:prod": "tsx --env-file=.env --env-file=.env.prod src/server.ts",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file=.env --env-file=.env.dev src/scripts/seed.ts",
    "seed:prod": "tsx --env-file=.env --env-file=.env.prod src/scripts/seed.ts"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
